# App
PORT=3000
API_KEY=change-me-local-dev-key

# PostgreSQL (Docker Compose uses the service name "postgres", not localhost)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/document_api?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_api

# Redis (Docker Compose uses the service name "redis", not localhost)
REDIS_URL=redis://redis:6379

# MinIO / S3-compatible storage (Docker Compose uses the service name "minio", not localhost)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
