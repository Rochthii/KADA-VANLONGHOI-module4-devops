# App
PORT=3100
API_KEY=change-me-shortener-key

# PostgreSQL (Docker Compose uses the service name "postgres", not localhost)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/url_shortener?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener

# Redis (Docker Compose uses the service name "redis", not localhost)
REDIS_URL=redis://redis:6379
